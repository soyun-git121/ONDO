# docker-compose.yml(로컬 MySQL)이 읽는 변수. 복사해서 쓴다:  cp .env.example .env
# .env는 gitignore 대상 — 실제 값은 커밋하지 않는다.
# 값을 바꾸지 않아도 docker-compose.yml의 기본값으로 동작한다(로컬 전용).

MYSQL_ROOT_PASSWORD=ondo_local_root
MYSQL_DATABASE=ondo
MYSQL_USER=ondo
MYSQL_PASSWORD=ondo_local_pw

# 호스트에 설치된 MySQL(3306)과 충돌을 피하려고 3307을 쓴다.
# 바꾸면 backend local 프로파일의 DB_URL 포트도 함께 바꿔야 한다.
MYSQL_PORT=3307

# 관리자 로그인 비밀번호 (아이디는 ADMIN_USERNAME, 기본 admin).
# 이 값이 곧 로그인 비밀번호다 — 저장소에 커밋하지 말 것.
# 로컬은 backend/.env(gitignored)에, 운영은 배포 환경변수에 넣는다.
ADMIN_PASSWORD=
