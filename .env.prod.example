# 운영 배포용 환경변수. 서버에서 복사해 채운다:  cp .env.prod.example .env
# 이 .env는 절대 커밋하지 않는다(gitignored). docker-compose.prod.yml이 읽는다.

# --- DB ---
MYSQL_ROOT_PASSWORD=여기에_강한_루트비번
MYSQL_DATABASE=ondo
MYSQL_USER=ondo
MYSQL_PASSWORD=여기에_강한_DB비번

# --- 앱 시크릿 ---
# JWT_SECRET 생성(리눅스):  openssl rand -base64 48
JWT_SECRET=여기에_생성한_긴_랜덤값
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin2580

# --- 네이버 뉴스 API (선택 — 없으면 뉴스 가져오기 기능만 비활성) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
